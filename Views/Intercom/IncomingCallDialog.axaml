<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:ORControlPanelNew.ViewModels.Intercom"
        x:Class="ORControlPanelNew.Views.Intercom.IncomingCallDialog"
        x:DataType="vm:IntercomDialogViewModel"
        Title="Incoming Call"
        Width="400" Height="250"
        SystemDecorations="None"
        WindowStartupLocation="CenterOwner"
        TransparencyLevelHint="AcrylicBlur"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False">

    <Border Background="#CC111111" CornerRadius="12" BorderBrush="#333" BorderThickness="1" Padding="20">
        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="30">
            
            <StackPanel Spacing="10" HorizontalAlignment="Center">
                <Image Source="avares://ORControlPanelNew/Assets/Icons/telephone.png" Width="48" Height="48"/>
                <TextBlock Text="INCOMING CALL..." 
                           Foreground="White" 
                           FontSize="24" 
                           FontWeight="Bold" 
                           HorizontalAlignment="Center"/>
            </StackPanel>

            <StackPanel Orientation="Horizontal" Spacing="40" HorizontalAlignment="Center">
                <!-- Pick Up Button -->
                <Button Command="{Binding PickupCommand}"
                        Width="120" Height="50"
                        CornerRadius="25"
                        Background="#4CAF50"
                        HorizontalContentAlignment="Center"
                        VerticalContentAlignment="Center">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <TextBlock Text="PICK UP" FontWeight="Bold" Foreground="White"/>
                    </StackPanel>
                </Button>

                <!-- Hang Up Button -->
                <Button Command="{Binding HangupCommand}"
                        Width="120" Height="50"
                        CornerRadius="25"
                        Background="#F44336"
                        HorizontalContentAlignment="Center"
                        VerticalContentAlignment="Center">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <TextBlock Text="HANG UP" FontWeight="Bold" Foreground="White"/>
                    </StackPanel>
                </Button>
            </StackPanel>
            
        </StackPanel>
    </Border>
</Window>
