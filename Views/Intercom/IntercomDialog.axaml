<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="using:ORControlPanelNew.ViewModels.Intercom"
        xmlns:helpers="using:ORControlPanelNew.Helpers"
        xmlns:conv="using:ORControlPanelNew.Converters"
        mc:Ignorable="d"
        x:Class="ORControlPanelNew.Views.Intercom.IntercomDialog"
        x:DataType="vm:IntercomDialogViewModel"
        Title="Inter-com"
        Width="800" 
        WindowStartupLocation="CenterOwner"
        x:Name="RootWindow">
	<Window.Resources>
		<vm:IntercomDialogViewModel x:Key="IntercomVM"/>
		<conv:ZeroToVisibilityConverter x:Key="ZeroToVisibilityConverter"/>
	</Window.Resources>
	<Window.DataContext>
		<StaticResource ResourceKey="IntercomVM"/>
	</Window.DataContext>
	<Window.Styles>
		<Style Selector="Button.dialer-btn">
			<Setter Property="Width" Value="58"/>
			
			<Setter Property="FontSize" Value="24"/>
			<Setter Property="FontWeight" Value="Bold"/>
			<Setter Property="Margin" Value="4"/>
			<Setter Property="Background" Value="#f0f0f0"/>
			<Setter Property="Foreground" Value="Black"/>
			<Setter Property="BorderBrush" Value="#b0b0b0"/>
			<Setter Property="BorderThickness" Value="2"/>
			<Setter Property="CornerRadius" Value="12"/>
		</Style>
	</Window.Styles>
	<Grid ColumnDefinitions="300,*" Margin="20">
		<!-- Dialer Section (Left) -->
        <Border Grid.Column="0" Background="#1A1A1A" CornerRadius="16" Padding="20" BorderBrush="#333" BorderThickness="1">
    		<StackPanel HorizontalAlignment="Stretch" VerticalAlignment="Top" Spacing="16">
                <StackPanel Orientation="Horizontal" Spacing="10" Margin="0,0,0,10">
                    <Image Source="avares://ORControlPanelNew/Assets/Icons/dialer.png" Width="20" Height="20"/>
                    <TextBlock Text="DIALER" Foreground="White" FontSize="14" FontWeight="Bold" VerticalAlignment="Center"/>
                </StackPanel>

    			<!-- Display -->
                <Border Background="#232323" CornerRadius="10" HorizontalAlignment="Stretch" Height="50" BorderBrush="#7CB342" BorderThickness="1.5">
        			<TextBlock Text="{Binding DialedNumber, Mode=OneWay}" FontSize="24" VerticalAlignment="Center"
        					   Margin="16,0" Foreground="#7CB342" TextAlignment="Left" FontWeight="Bold"/>
                </Border>

    			<!-- Dialer Buttons -->
    			<Grid HorizontalAlignment="Stretch">
    				<Grid.RowDefinitions>
    					<RowDefinition Height="Auto"/>
    					<RowDefinition Height="Auto"/>
    					<RowDefinition Height="Auto"/>
    					<RowDefinition Height="Auto"/>
    				</Grid.RowDefinitions>
    				<Grid.ColumnDefinitions>
    					<ColumnDefinition Width="*"/>
    					<ColumnDefinition Width="*"/>
    					<ColumnDefinition Width="*"/>
    				</Grid.ColumnDefinitions>
                    
                    <!-- Styles for dial buttons -->
                    <Grid.Styles>
                        <Style Selector="Button.dialer-btn">
                            <Setter Property="Width" Value="65"/>
                            <Setter Property="Height" Value="65"/>
                            <Setter Property="FontSize" Value="22"/>
                            <Setter Property="FontWeight" Value="Bold"/>
                            <Setter Property="Margin" Value="6"/>
                            <Setter Property="Background" Value="#232323"/>
                            <Setter Property="Foreground" Value="White"/>
                            <Setter Property="BorderBrush" Value="#444"/>
                            <Setter Property="BorderThickness" Value="1"/>
                            <Setter Property="CornerRadius" Value="12"/>
                        </Style>
                        <Style Selector="Button.dialer-btn:pointerover /template/ ContentPresenter#PART_ContentPresenter">
                            <Setter Property="Background" Value="#333" />
                            <Setter Property="BorderBrush" Value="#7CB342" />
                        </Style>
                    </Grid.Styles>

    				<Button Content="1" Command="{Binding DialCommand}" CommandParameter="1" Grid.Row="0" Grid.Column="0" Classes="dialer-btn"/>
    				<Button Content="2" Command="{Binding DialCommand}" CommandParameter="2" Grid.Row="0" Grid.Column="1" Classes="dialer-btn"/>
    				<Button Content="3" Command="{Binding DialCommand}" CommandParameter="3" Grid.Row="0" Grid.Column="2" Classes="dialer-btn"/>
    				<Button Content="4" Command="{Binding DialCommand}" CommandParameter="4" Grid.Row="1" Grid.Column="0" Classes="dialer-btn"/>
    				<Button Content="5" Command="{Binding DialCommand}" CommandParameter="5" Grid.Row="1" Grid.Column="1" Classes="dialer-btn"/>
    				<Button Content="6" Command="{Binding DialCommand}" CommandParameter="6" Grid.Row="1" Grid.Column="2" Classes="dialer-btn"/>
    				<Button Content="7" Command="{Binding DialCommand}" CommandParameter="7" Grid.Row="2" Grid.Column="0" Classes="dialer-btn"/>
    				<Button Content="8" Command="{Binding DialCommand}" CommandParameter="8" Grid.Row="2" Grid.Column="1" Classes="dialer-btn"/>
    				<Button Content="9" Command="{Binding DialCommand}" CommandParameter="9" Grid.Row="2" Grid.Column="2" Classes="dialer-btn"/>
    				<Button Content="*" Command="{Binding DialCommand}" CommandParameter="*" Grid.Row="3" Grid.Column="0" Classes="dialer-btn"/>
    				<Button Content="0" Command="{Binding DialCommand}" CommandParameter="0" Grid.Row="3" Grid.Column="1" Classes="dialer-btn"/>
    				<Button Content="#" Command="{Binding DialCommand}" CommandParameter="#" Grid.Row="3" Grid.Column="2" Classes="dialer-btn"/>
    			</Grid>

    			<!-- Action Buttons -->
    			<StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Spacing="16" Margin="0,10,0,0">
                    <Button Command="{Binding BackspaceCommand}" Background="#C62828" Width="100" Height="45" CornerRadius="10">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Image Source="avares://ORControlPanelNew/Assets/Icons/delete.png" Width="20" Height="20"/>
                            <TextBlock Text="DEL" FontWeight="Bold" VerticalAlignment="Center" Foreground="White"/>
                        </StackPanel>
                    </Button>
    				<Button Command="{Binding CallCommand}" Background="#2E7D32" Width="100" Height="45" CornerRadius="10">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Image Source="avares://ORControlPanelNew/Assets/Icons/telephone.png" Width="20" Height="20"/>
                            <TextBlock Text="CALL" FontWeight="Bold" VerticalAlignment="Center" Foreground="White"/>
                        </StackPanel>
                    </Button>
    			</StackPanel>
    		</StackPanel>
        </Border>

		<!-- Phonebook Section (Right) -->
        <Border Grid.Column="1" Background="#181A1B" CornerRadius="16" Padding="20" Margin="20,0,0,0" BorderBrush="#444" BorderThickness="1">
    		<Grid RowDefinitions="Auto,Auto,Auto,*">
                <!-- Header -->
                <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="12" Margin="0,0,0,20">
                    <Image Source="avares://ORControlPanelNew/Assets/Icons/contacts.png" Width="24" Height="24"/>
                    <TextBlock Text="PHONEBOOK" Foreground="White" FontSize="18" FontWeight="Bold" VerticalAlignment="Center"/>
                </StackPanel>

                <!-- Add Contact Section -->
                <Border Grid.Row="1" Background="#232323" CornerRadius="12" Padding="16" Margin="0,0,0,16" BorderBrush="#333" BorderThickness="1">
                    <Grid ColumnDefinitions="*,*,Auto" RowDefinitions="Auto,Auto" HorizontalAlignment="Stretch">
                        <TextBlock Grid.Row="0" Grid.Column="0" Text="Name" Foreground="#888" FontSize="12" Margin="4,0,0,2"/>
                        <TextBox Grid.Row="1" Grid.Column="0" Text="{Binding NewContactName, Mode=TwoWay}" 
                                 Background="#1A1A1A" BorderBrush="#444" Foreground="White"
                                 Margin="4,0,4,0" Height="36" VerticalContentAlignment="Center" CornerRadius="6"
                                 CaretBrush="White">
                            <TextBox.Styles>
                                <Style Selector="TextBox:focus /template/ Border#PART_BorderElement">
                                    <Setter Property="Background" Value="#1A1A1A"/>
                                    <Setter Property="BorderBrush" Value="#7CB342"/>
                                </Style>
                            </TextBox.Styles>
                        </TextBox>

                        <TextBlock Grid.Row="0" Grid.Column="1" Text="Number" Foreground="#888" FontSize="12" Margin="4,0,0,2"/>
                        <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding NewContactNumber, Mode=TwoWay}" 
                                 Background="#1A1A1A" BorderBrush="#444" Foreground="White"
                                 Margin="4,0,4,0" Height="36" VerticalContentAlignment="Center" CornerRadius="6"
                                 CaretBrush="White">
                            <TextBox.Styles>
                                <Style Selector="TextBox:focus /template/ Border#PART_BorderElement">
                                    <Setter Property="Background" Value="#1A1A1A"/>
                                    <Setter Property="BorderBrush" Value="#7CB342"/>
                                </Style>
                            </TextBox.Styles>
                        </TextBox>

                        <Button Grid.Row="1" Grid.Column="2" Content="ADD" Command="{Binding SaveContactCommand}" 
                                Background="#7CB342" Foreground="Black" FontWeight="Bold" Width="60" Height="36"
                                CornerRadius="8" VerticalAlignment="Bottom" Margin="4,0,0,0"/>
                    </Grid>
                </Border>

                <Separator Grid.Row="2" Background="#333" Margin="0,0,0,16"/>

        		<!-- Contacts List -->
                <ScrollViewer Grid.Row="3">
                    <StackPanel>
            			<TextBlock Text="No contacts found." 
                                   IsVisible="{Binding Contacts.Count, Converter={StaticResource ZeroToVisibilityConverter}}"
                                   Foreground="#666" HorizontalAlignment="Center" FontStyle="Italic" Margin="0,40,0,0"/>

            			<ItemsControl ItemsSource="{Binding Contacts}">
            				<ItemsControl.ItemTemplate>
            					<DataTemplate>
            						<Border Background="#232323" CornerRadius="12" Padding="12" Margin="0,0,0,8" 
                                            BorderBrush="#333" BorderThickness="1">
                                        <Grid ColumnDefinitions="*,120" MinHeight="60">
                                            <StackPanel Grid.Column="0" VerticalAlignment="Center" Spacing="4">
                                                <TextBlock Text="{Binding Name}" FontWeight="Bold" Foreground="#7CB342" FontSize="18"/>
                                                <TextBlock Text="{Binding Number}" Foreground="White" FontSize="16" Opacity="0.8"/>
                                            </StackPanel>

                                            <!-- Action Buttons Column -->
                                            <Grid Grid.Column="1" ColumnDefinitions="*,*" VerticalAlignment="Center">
                                                <!-- Call Button -->
                                                <Button Grid.Column="0" Command="{Binding ((vm:IntercomDialogViewModel)DataContext).CallContactCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                        CommandParameter="{Binding .}"
                                                        Background="#2E7D32" Width="48" Height="48" CornerRadius="24" Padding="10"
                                                        HorizontalAlignment="Center">
                                                    <Image Source="avares://ORControlPanelNew/Assets/Icons/telephone.png" Width="24" Height="24"/>
                                                </Button>

                                                <!-- Delete Button -->
                                                <Button Grid.Column="1" Command="{Binding ((vm:IntercomDialogViewModel)DataContext).DeleteContactCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                        CommandParameter="{Binding .}"
                                                        Background="#C62828" Width="48" Height="48" CornerRadius="24" Padding="10"
                                                        HorizontalAlignment="Center">
                                                    <Image Source="avares://ORControlPanelNew/Assets/Icons/delete.png" Width="24" Height="24"/>
                                                </Button>
                                            </Grid>
                                        </Grid>
            						</Border>
            					</DataTemplate>
            				</ItemsControl.ItemTemplate>
            			</ItemsControl>
                    </StackPanel>
                </ScrollViewer>
    		</Grid>
        </Border>
	</Grid>
</Window>
